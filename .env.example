# ============================================================
# Thailand Flood Risk Monitoring — Environment Variables
# ============================================================
# TEMPLATE ONLY — fill in your real values, never commit this file

# --- RID Reservoir / Dam API ---
# Public endpoints — no auth key needed
RID_DAM_API_URL=https://app.rid.go.th/reservoir/api/dam/public
RID_RESERVOIR_API_URL=https://app.rid.go.th/reservoir/api/reservoir/public

# --- TMD Weather Forecast API ---
# Obtain token from https://data.tmd.go.th/nwpapi/doc/main/getting_start.html
TMD_API_TOKEN=YOUR_TMD_JWT_TOKEN_HERE
TMD_FORECAST_URL=https://data.tmd.go.th/nwpapi/v1/api/forecasts/area

# --- HDFS ---
HDFS_NAMENODE_URL=http://namenode:9870
HDFS_USER=root

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC=reservoir_updates
KAFKA_CONSUMER_GROUP=flood-monitoring-group

# --- Hive ---
HIVE_HOST=hive-server
HIVE_PORT=10000
HIVE_DATABASE=flood_monitoring

# --- Airflow ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLt0nIo3-s=

# --- Pipeline ---
PIPELINE_WATERMARK_FILE=/opt/airflow/data/.watermark.json
